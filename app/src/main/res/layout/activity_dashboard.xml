

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Retour"
            android:textColor="#174C3B"
            android:backgroundTint="#E8F0E8"
            android:layout_marginBottom="12dp" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mon Budget"
                android:textColor="#173F32"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#E8EEE7"
                android:gravity="center"
                android:text="☰"
                android:textColor="#173F32"
                android:textSize="20sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Mois 1 sur 3"
            android:textColor="#89958C"
            android:textSize="13sp"/>


        <!-- Onglets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="22dp"
            android:background="#E9EDE7"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabExpenses"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#174C3B"
                android:gravity="center"
                android:text="Dépenses"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabIncome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Revenus"
                android:textColor="#68766C"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabSavings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Épargne"
                android:textColor="#68766C"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabGoals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Objectifs"
                android:textColor="#68766C"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Titre graphique -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tes dépenses"
                android:textColor="#263E33"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mois 1  ▾"
                android:textColor="#64746A"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Graphique circulaire -->

        <!-- Résumé financier -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dashboard_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <com.example.budgetchallenge.DonutChartView
                android:id="@+id/donutChart"
                android:layout_width="205dp"
                android:layout_height="205dp" />

            <!-- Légende -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●  Loyer       500 DT"
                        android:textColor="#244B3C"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="●  Alimentation  350 DT"
                        android:textColor="#578F70"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="●  Transport  150 DT"
                        android:textColor="#A9C5AD"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●  Factures  200 DT"
                        android:textColor="#829C89"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="●  Autres  200 DT"
                        android:textColor="#C2D2C2"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Résumé financier"
            android:textColor="#263E33"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dashboard_card"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:text="Revenu mensuel"
                    android:textColor="#829087"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1 800 DT"
                    android:textColor="#174C3B"
                    android:textSize="19sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/dashboard_card"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:text="Dépenses totales"
                    android:textColor="#829087"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1 400 DT"
                    android:textColor="#174C3B"
                    android:textSize="19sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dashboard_card"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:text="Solde courant"
                    android:textColor="#829087"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="400 DT"
                    android:textColor="#174C3B"
                    android:textSize="19sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/dashboard_card"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:text="Épargne cumulée"
                    android:textColor="#829087"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtSavings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0 DT"
                    android:textColor="#174C3B"
                    android:textSize="19sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Objectif -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#EAF0E6"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌱  Ton objectif d'épargne"
                android:textColor="#244B3C"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtGoalProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 DT sur 1 200 DT"
                android:textColor="#53685A"
                android:textSize="13sp"/>

            <ProgressBar
                android:id="@+id/progressGoal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#245B45"
                android:progressBackgroundTint="#D0DDCE"/>

            <TextView
                android:id="@+id/txtGoalPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 % atteint"
                android:textColor="#718078"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Épargne du mois -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#EAF0E6"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Épargne du mois"
                android:textColor="#244B3C"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etMonthlySavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Montant à épargner en DT"
                android:inputType="numberDecimal"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnNextMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Valider mon épargne et passer au mois suivant"
                android:textColor="#FFFFFF"
                android:backgroundTint="#174C3B"/>

        </LinearLayout><!-- Actions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Gérer mon budget"
            android:textColor="#263E33"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnDecisions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Décisions financières"
            android:textColor="#FFFFFF"
            android:backgroundTint="#174C3B"/>

        <Button
            android:id="@+id/btnAnalysis"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Analyse et recommandations"
            android:textColor="#FFFFFF"
            android:backgroundTint="#245B45"/>

        <Button
            android:id="@+id/btnResults"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"
            android:text="Voir le bilan"
            android:textColor="#FFFFFF"
            android:backgroundTint="#245B45"/>
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Voir l'historique"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/btnEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Événement imprévu"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
