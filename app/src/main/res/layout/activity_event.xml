<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent">


    <!-- Photo transparente -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.65" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- En-tête -->

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackEvent"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="‹"
                android:textSize="30sp"
                android:textColor="#174F3E"
                android:backgroundTint="#E6EFE5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Événement imprévu"
                android:textColor="#174F3E"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Carte principale -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_event"

            android:orientation="vertical"
            android:elevation="10dp"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Un imprévu peut changer ton budget !"
                android:textColor="#174F3E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Photo personnalisée -->
            <ImageView
                android:id="@+id/imgEvent"
                android:layout_width="match_parent"
                android:layout_height="284dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_event"
                android:contentDescription="Téléphone en panne"
                android:elevation="8dp"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/telephone" />



            <TextView
                android:id="@+id/txtEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Panne de téléphone"
                android:textColor="#174F3E"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Ton téléphone est tombé en panne."
                android:textColor="#718078"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtEventCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#FCE8E8"
                android:gravity="center"
                android:padding="16dp"
                android:text="Coût estimé : 180 DT"
                android:textColor="#D32F2F"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Choix de financement -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Comment financer cette dépense ?"
            android:textColor="#174F3E"
            android:textSize="19sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgEventChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/rbReduceExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Réduire les dépenses variables"
                android:textColor="#29483B"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbUseSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Utiliser une partie de mon épargne"
                android:textColor="#29483B"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbPostponeExpense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reporter une autre dépense"
                android:textColor="#29483B"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbAcceptDeficit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accepter un déficit"
                android:textColor="#29483B"
                android:padding="8dp" />

        </RadioGroup>

        <Button
            android:id="@+id/btnValidateEvent"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp"
            android:text="Valider mon choix"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#174F3E" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

