<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Retour -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#E8F0E8"
            android:text="← Retour"
            android:textColor="#174C3B"
            android:textStyle="bold" />

        <!-- En-tête -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Décisions financières"
            android:textColor="#174C3B"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Prenez les meilleures décisions pour votre budget."
            android:textColor="#65776A"
            android:textSize="14sp" />

        <!-- Solde disponible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/dashboard_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 SOLDE DISPONIBLE"
                android:textColor="#65776A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAvailableBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="400 DT"
                android:textColor="#174C3B"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 1. Actions disponibles -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Actions disponibles"
            android:textColor="#174C3B"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rgDecisions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <RadioButton
                android:id="@+id/rbReduce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:padding="14dp"
                android:background="@drawable/dashboard_card"
                android:buttonTint="#438B68"
                android:text="✂️ Réduire une catégorie variable"
                android:textColor="#174C3B"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbPostpone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:padding="14dp"
                android:background="@drawable/dashboard_card"
                android:buttonTint="#438B68"
                android:text="📅 Reporter une dépense"
                android:textColor="#174C3B"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbTraining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:padding="14dp"
                android:background="@drawable/dashboard_card"
                android:buttonTint="#438B68"
                android:text="🎓 Investir dans une formation fictive"
                android:textColor="#174C3B"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbCompare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:padding="14dp"
                android:background="@drawable/dashboard_card"
                android:buttonTint="#438B68"
                android:text="📊 Comparer les stratégies"
                android:textColor="#174C3B"
                android:textSize="15sp" />

        </RadioGroup>

        <!-- 2. Choix de l'utilisateur -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="2. Votre choix"
            android:textColor="#174C3B"
            android:textSize="19sp"
            android:textStyle="bold" />
        <!-- Catégorie à réduire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Catégorie à réduire"
            android:textColor="#174C3B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/card_budget"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/dashboard_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Montant de la décision (DT)"
                android:textColor="#174C3B"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_budget"
                android:hint="Exemple : 50"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#174C3B"
                android:textColorHint="#89978B" />

        </LinearLayout>

        <!-- 3. Impact estimé -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="3. Impact estimé"
            android:textColor="#174C3B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/dashboard_card">

            <TextView
                android:id="@+id/tvImpact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="L'impact de votre décision apparaîtra ici."
                android:textColor="#65776A"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

        <!-- 4. Validation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="4. Validation"
            android:textColor="#174C3B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreview"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="@color/button_green"
            android:text="Calculer l'impact"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnValidate"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="25dp"
            android:backgroundTint="#174C3B"
            android:text="Valider ma décision ✓"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>